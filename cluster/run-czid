#!/usr/bin/env python3

# ---------------------------------------------------------------------------------------------
# Runs the CZ ID short-read-mngs and long-read-mngs WDL pipelines via miniwdl on the HPC using
# the Slurm + Singularity backend. Takes as input a samplesheet CSV file.
#
# Usage:
#   run-czid samplesheet.csv \
#       --fastq-dir /path/to/fastqs \
#       --output-dir /path/to/output \
#       [--serial]
# ---------------------------------------------------------------------------------------------

import sys
import os
import argparse
import csv
import shlex
import subprocess

# Predefined configurations
CZID_WORKFLOWS_DIR = "/data/openomics/prod/czid-workflows"
SHORT_READ_WORKFLOW_DIR = os.path.join(CZID_WORKFLOWS_DIR, "workflows/short-read-mngs")
LONG_READ_WORKFLOW_DIR = os.path.join(CZID_WORKFLOWS_DIR, "workflows/long-read-mngs")
MINIWDL_CFG = os.path.join(CZID_WORKFLOWS_DIR, "cluster/miniwdl.cfg")
DEFAULT_HOST_GENOME = "human"
HOST_REFERENCE_ROOT = "/data/openomics/references/czid-workflows/host_filter"
HOST_REFERENCE_TEMPLATES = {
    "short_read": {
        "human": "human_telomere/2023-07-05/host-genome-generation-1/human_telomere.{suffix}",
        "mosquito": "mosquito/20221031/{input_name}/mosquito.{suffix}",
        "bat": "bat/20221031/{input_name}/bat.{suffix}",
        "macaca_fascicularis": "macaca_fascicularis/2023-06-08/host-genome-generation-1/macaca_fascicularis.{suffix}",
    },
    "long_read": {
        "human": "human_telomere/2023-07-05/host-genome-generation-1/human_telomere_{library_type}.mmi",
        "mosquito": "mosquitos/2019-10-02/mosquitos_minimap2_genome_{library_type}.mmi",
        "bat": "bat/2019-07-02/bat_minimap2_genome_{library_type}.mmi",
        "macaca_fascicularis": "macaca_fascicularis/2023-06-08/host-genome-generation-1/macaca_fascicularis_{library_type}.mmi",
    },
}

SBATCH_HEADER = """#!/usr/bin/env bash
#SBATCH --job-name={job_name}
#SBATCH --output={out_dir}/%x_%j.out
#SBATCH --error={out_dir}/%x_%j.err
#SBATCH --partition=all
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=7-00:00:00

set -euo pipefail

module load miniwdl

"""


def load_samplesheet(path):
    with open(path, newline="", encoding="utf-8-sig") as samplesheet:
        yield from csv.DictReader(samplesheet)


def optional_value(row, column, default=None):
    value = row.get(column)
    if isinstance(value, str):
        return value.strip() or default
    return default


def build_host_reference_inputs(read_type, host_genome, nucleotide_type, sample_name):
    templates = HOST_REFERENCE_TEMPLATES[read_type]
    if host_genome not in templates:
        raise ValueError(
            f"Sample {sample_name}: unsupported host_genome '{host_genome}'. Expected one of: {', '.join(templates)}"
        )

    if read_type == "short_read":
        references = {
            f"host_filter.{input_name}": templates[host_genome].format(input_name=input_name, suffix=suffix)
            for input_name, suffix in (
                ("bowtie2_index_tar", "bowtie2.tar"),
                ("hisat2_index_tar", "hisat2.tar"),
                ("kallisto_idx", "kallisto.idx"),
            )
        }
    else:
        references = {
            input_name: templates[host].format(library_type=nucleotide_type.lower())
            for input_name, host in (
                ("minimap_host_db", host_genome),
                ("minimap_human_db", "human"),
            )
        }

    return [f"{input_name}={os.path.join(HOST_REFERENCE_ROOT, path)}" for input_name, path in references.items()]


def build_command(row, output_dir, fastq_dir):
    sample_name = row["sample_name"]
    platform = row["seq_platform"].strip().upper()
    nucleotide_type = row["seq_input"].strip().upper()
    r1 = os.path.join(fastq_dir, row["seq_fastq_R1"])
    r2_name = optional_value(row, "seq_fastq_R2")
    r2 = os.path.join(fastq_dir, r2_name) if r2_name else None
    host_genome = optional_value(row, "host_genome", DEFAULT_HOST_GENOME)

    out_dir = os.path.join(output_dir, sample_name)

    read_type = {"ILLUMINA": "short_read", "ONT": "long_read"}.get(platform)
    if read_type is None:
        return None, None
    host_reference_inputs = build_host_reference_inputs(read_type, host_genome, nucleotide_type, sample_name)

    if read_type == "short_read":
        workflow = os.path.join(SHORT_READ_WORKFLOW_DIR, "local_driver.wdl")
        inputs = [f"fastqs_0={r1}"]
        if r2:
            inputs.append(f"fastqs_1={r2}")
        inputs += [
            *host_reference_inputs,
            f"host_filter.nucleotide_type={nucleotide_type}",
            f"host_filter.host_genome={host_genome}",
        ]
    else:
        workflow = os.path.join(LONG_READ_WORKFLOW_DIR, "run.wdl")
        inputs = [
            f"input_fastq={r1}",
            f"library_type={nucleotide_type}",
            *host_reference_inputs,
        ]

    workflow_name = f"{read_type.replace('_', '-')}-mngs"
    job_name = f"czid_{read_type}_mngs_{sample_name}"
    cfg = os.path.join(CZID_WORKFLOWS_DIR, f"cluster/skyline_{workflow_name}_config_2024-02-06.yml")
    cmd = [
        "miniwdl", "run", workflow,
        f"docker_image_id=czid-{workflow_name}",
        *inputs,
        "-i", cfg,
        "--cfg", MINIWDL_CFG,
        "-d", out_dir,
        "--verbose",
    ]
    return job_name, cmd


def submit_sample(row, output_dir, fastq_dir, serial, prev_job_id):
    sample_name = row["sample_name"]
    job_name, cmd = build_command(row, output_dir, fastq_dir)
    if cmd is None:
        print(f"Skipping {sample_name}: unknown seq_platform '{row['seq_platform']}'", file=sys.stderr)
        return prev_job_id

    out_dir = os.path.join(output_dir, sample_name)
    os.makedirs(out_dir, exist_ok=True)
    sbatch_path = os.path.join(out_dir, "submit.sbatch")

    script = SBATCH_HEADER.format(job_name=job_name, out_dir=out_dir)
    script += shlex.join(cmd) + "\n"

    with open(sbatch_path, "w") as f:
        f.write(script)

    sbatch_cmd = ["sbatch"]
    if serial and prev_job_id:
        sbatch_cmd.append(f"--dependency=afterok:{prev_job_id}")
    sbatch_cmd.append(sbatch_path)

    print(f"Submitting sample {sample_name} ({job_name})" + (f" (after job {prev_job_id})" if serial and prev_job_id else ""))
    result = subprocess.run(sbatch_cmd, check=True, capture_output=True, text=True)
    return result.stdout.strip().split()[-1]


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("samplesheet")
    parser.add_argument("--fastq-dir", required=True)
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--serial", action="store_true", help="Chain samples via Slurm job dependencies, one at a time (default: submit all in parallel)")
    args = parser.parse_args()

    prev_job_id = None
    for row in load_samplesheet(args.samplesheet):
        prev_job_id = submit_sample(row, args.output_dir, args.fastq_dir, args.serial, prev_job_id)


if __name__ == "__main__":
    main()
